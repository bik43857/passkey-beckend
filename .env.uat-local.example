# Copy to backend/.env for running the "uat" profile locally.
# cp .env.uat-local.example backend/.env
# Then: cd backend && mvn spring-boot:run -Dspring-boot.run.profiles=uat

DATABASE_URL=jdbc:postgresql://localhost:5433/authdb_uat
DATABASE_USERNAME=authuser
DATABASE_PASSWORD=authpass

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=My Passkey App (UAT)
WEBAUTHN_ORIGIN=http://localhost:5173
WEBAUTHN_CHALLENGE_TTL=120

SESSION_SECRET=uat-local-only-change-me
SESSION_TTL_HOURS=12
# http://localhost has no TLS, so the uat profile's cookie-secure default
# (true) must be turned off here or the browser will silently drop the
# session cookie.
SESSION_COOKIE_SECURE=false

CORS_ALLOWED_ORIGINS=http://localhost:5173
